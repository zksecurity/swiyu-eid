{
  "name": "@privacy-scaling-explorations/jwt-es256-circom",
  "description": "circom circuits for verifying JWTs signed with ES256",
  "version": "0.0.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/privacy-scaling-explorations/zkID"
  },
  "scripts": {
    "test": "NODE_OPTIONS=--max-old-space-size=16384 tsx ./node_modules/mocha/bin/mocha.js --no-config --extension ts --timeout 900000 --ignore \"tests/**/*.poc.test.ts\" \"tests/**/*.test.ts\"",
    "test:poc": "NODE_OPTIONS=--max-old-space-size=16384 tsx ./node_modules/mocha/bin/mocha.js --no-config --extension ts --timeout 900000 \"tests/**/*.poc.test.ts\"",
    "save_input_file": "npx ts-node src/save_inputs.ts",
    "compile:jwt": "bash scripts/compile.sh jwt",
    "compile:jwt:1k": "bash scripts/compile.sh jwt_1k",
    "compile:jwt:2k": "bash scripts/compile.sh jwt_2k",
    "compile:jwt:4k": "bash scripts/compile.sh jwt_4k",
    "compile:jwt:8k": "bash scripts/compile.sh jwt_8k",
    "compile:show": "bash scripts/compile.sh show",
    "compile:mdoc": "bash scripts/compile.sh mdoc",
    "compile:ecdsa": "bash scripts/compile.sh ecdsa",
    "compile:swiyu": "bash scripts/compile.sh swiyu_age18_status_2k",
    "compile:swiyu:compact": "bash scripts/compile.sh swiyu_age18_status_compact",
    "compile:swiyu:prepare": "bash scripts/compile.sh swiyu_age18_prepare_compact",
    "compile:swiyu:show-split": "bash scripts/compile.sh swiyu_age18_show_split",
    "compile:swiyu:show-packed-v2": "bash scripts/compile.sh swiyu_age18_show_packed_chunk_v2",
    "compile:swiyu:canton-prepare": "bash scripts/compile.sh swiyu_canton_prepare_compact",
    "compile:swiyu:canton-show": "bash scripts/compile.sh swiyu_canton_show_split",
    "compile:swiyu:residence-prepare": "bash scripts/compile.sh swiyu_residence_prepare_compact",
    "compile:swiyu:residence-combined-prepare": "bash scripts/compile.sh swiyu_residence_combined_prepare_compact",
    "compile:swiyu:residence-show": "bash scripts/compile.sh swiyu_residence_show_split",
    "compile:swiyu:residence-show-packed-v2": "bash scripts/compile.sh swiyu_residence_show_packed_chunk_v2",
    "compile:swiyu:nullifier-core-prepare": "bash scripts/compile.sh swiyu_nullifier_prepare",
    "compile:swiyu:nullifier-core-show": "bash scripts/compile.sh swiyu_nullifier_show",
    "compile:swiyu:nullifier-age-prepare": "bash scripts/compile.sh swiyu_nullifier_age18_prepare",
    "compile:swiyu:nullifier-age-show": "bash scripts/compile.sh swiyu_nullifier_age18_show",
    "compile:swiyu:nullifier-age-show-packed-v2": "bash scripts/compile.sh swiyu_nullifier_age18_show_packed_chunk_v2",
    "compile:status:dense": "bash scripts/compile.sh swiyu_status_dense_17_bench",
    "compile:status:binary-core": "bash scripts/compile.sh swiyu_status_binary_17_core_bench",
    "compile:status:ternary-core": "bash scripts/compile.sh swiyu_status_ternary_11_core_bench",
    "compile:status:packed-v2-core": "bash scripts/compile.sh swiyu_status_packed_chunk_v2_core_bench",
    "compile:status:sparse": "bash scripts/compile.sh swiyu_status_sparse_64_bench",
    "fixtures:status-proofs": "node --import tsx src/status-proof-benchmark-fixtures.ts",
    "benchmark:status-proofs": "bash ../scripts/benchmark-status-proofs.sh",
    "compile:all": "bash scripts/compile.sh all",
    "generate:inputs": "npx ts-node src/generate-inputs.ts",
    "generate:inputs:mdoc": "npx ts-node src/generate-mdoc-inputs.ts",
    "setup": "npx circomkit setup jwt",
    "prove": "npx circomkit prove jwt",
    "verify": "npx circomkit verify jwt"
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "^5.2.0",
    "@noble/curves": "^1.8.1",
    "@noble/hashes": "^1.7.1",
    "@types/asn1": "^0.2.4",
    "@zk-email/circuits": "^6.3.3-nightly-20250214",
    "@zk-email/helpers": "^6.4.2",
    "asn1": "^0.2.6",
    "base64-js": "^1.5.1",
    "bs58": "^6.0.0",
    "circom_tester": "^0.0.21",
    "circomkit": "^0.3.4",
    "circomlib": "^2.0.5",
    "did-resolver": "^4.1.0",
    "jose": "^6.0.10",
    "jsonwebtoken": "^9.0.2",
    "jwk-to-pem": "^2.0.7",
    "jws": "^4.0.0",
    "key-did-resolver": "^4.0.0",
    "mocha": "^11.1.0",
    "safe-buffer": "^5.2.1"
  },
  "devDependencies": {
    "@auth0/mdl": "^3.0.1",
    "@peculiar/x509": "^2.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/jwk-to-pem": "^2.0.3",
    "@types/mocha": "^10.0.1",
    "@types/node": "^20.3.0",
    "cbor": "^10.0.0",
    "reflect-metadata": "^0.2.2",
    "ts-node": "^10.9.1",
    "tsx": "^4.21.0",
    "typescript": "^5.1.3"
  },
  "resolutions": {
    "snarkjs": "npm:0.7.6"
  },
  "packageManager": "yarn@4.13.0"
}

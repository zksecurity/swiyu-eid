{
  "schema": "swiyu.claim.v0",
  "id": "draft.swiyu.cutoff-status.v1",
  "packages": {
    "format": "swiyu.sd-jwt-es256@0",
    "assertions": "swiyu.presentation-assertions@0",
    "predicates": "core.predicates@1"
  },
  "credential": { "id": "eid", "format": "swiyu.sd-jwt-es256@0" },
  "attributes": {
    "birthdate": { "credential": "eid", "path": ["birthdate"], "type": "swiyu.date@0" }
  },
  "given": {
    "issuer": { "type": "swiyu.expected-issuer@0" },
    "now": { "type": "swiyu.unix-seconds@0" },
    "cutoff": { "type": "swiyu.date@0" },
    "session": { "type": "swiyu.expected-session@0" },
    "status": { "type": "swiyu.expected-status@0" }
  },
  "require": [
    {
      "id": "issuer_authentication",
      "assert": "credential.authentic@1",
      "args": { "credential": { "credential": "eid" }, "issuer": { "given": "issuer" } }
    },
    {
      "id": "metadata",
      "assert": "credential.expected-metadata@1",
      "args": { "credential": { "credential": "eid" }, "issuer": { "given": "issuer" } }
    },
    {
      "id": "validity",
      "assert": "credential.valid-at@1",
      "args": { "credential": { "credential": "eid" }, "time": { "given": "now" } }
    },
    {
      "id": "holder_authorization",
      "assert": "holder.signature-valid@1",
      "args": { "credential": { "credential": "eid" }, "transcript": { "assertion": "session_binding", "output": "expected_transcript" } }
    },
    {
      "id": "session_binding",
      "assert": "presentation.context-bound@1",
      "recipe": "swiyu.show-context@0",
      "args": {
        "session": { "given": "session" },
        "cutoff": { "given": "cutoff" },
        "time": { "given": "now" },
        "status": { "given": "status" },
        "profile": { "const": "swiyu-age18-status-2k-v0" }
      }
    },
    {
      "id": "status",
      "assert": "status.zero-at-reference@1",
      "args": { "credential": { "credential": "eid" }, "reference": { "given": "status" }, "time": { "given": "now" } }
    }
  ],
  "where": {
    "predicate": "date.on-or-before@1",
    "args": { "value": { "attribute": "birthdate" }, "limit": { "given": "cutoff" } }
  },
  "release": {
    "observer": "verifier",
    "semantic_values": ["acceptance", "eid.issuer", "eid.key_id", "eid.credential_type"],
    "protocol_derived": ["swiyu.public-context@0"],
    "opaque_channels": ["proof"],
    "branch_identity": "hidden"
  }
}
